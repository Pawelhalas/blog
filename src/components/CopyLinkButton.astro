---
import IconLink from "@/assets/icons/IconLink.svg";
import { useTranslations } from "@/i18n";

type Props = {
  /** Absolute URL to place on the clipboard. */
  url: string;
  /**
   * "menu" carries its own label, so the button reports its result in place.
   * "row" is icon-only: it reports into a `[data-copy-status]` element
   * elsewhere inside the surrounding `[data-copy-scope]`.
   */
  variant?: "row" | "menu";
  class?: string;
};

const { url, variant = "menu", class: className } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

{
  /*
  Copy-link is a share option like any other, so it exists wherever sharing
  exists - but it is not a URL, so it cannot live in the shareLinks config
  next to the platforms. It is rendered alongside them instead, and kept here
  so both surfaces get identical behaviour from one implementation.
*/
}
<button
  type="button"
  data-copy-link={url}
  data-idle={t.post.copyLink}
  data-done={t.post.copiedLink}
  data-failed={t.post.copyLinkFailed}
  title={t.post.copyLink}
  class:list={[
    "focus-visible:outline-accent rounded-[2px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dashed",
    variant === "menu"
      ? "share-menu__item font-data text-foreground hover:bg-muted flex w-full items-center gap-2 px-3 py-2 text-left text-[11px] tracking-[0.06em]"
      : // Deliberately identical to what LinkButton + ShareLinks give the
        // platform icons beside it: same inherited colour, same scale, same
        // rotate-on-hover. Copy-link is a peer of those icons, not a lesser
        // control, so it must not read as a different tier.
        "group hover:text-accent inline-flex scale-90 items-center gap-1 p-2 hover:rotate-6 sm:p-1",
    className,
  ]}
>
  <IconLink
    class:list={[
      variant === "menu"
        ? "size-4 shrink-0"
        : "inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110",
    ]}
    aria-hidden="true"
  />
  {
    variant === "menu" ? (
      <span data-copy-status aria-live="polite">
        {t.post.copyLink}
      </span>
    ) : (
      <span class="sr-only">{t.post.copyLink}</span>
    )
  }
</button>

<script>
  /*
    One delegated listener for every copy button on the page. Bound on the root
    element, which survives Astro's view transitions, so it attaches once.
  */
  const REVERT_AFTER_MS = 1600;

  /**
   * Where this button reports its result. The dropdown item holds its own
   * label; the icon-only row has none, so it borrows the "Share this post:"
   * caption sitting above it, marked with data-copy-status in the same scope.
   */
  function statusElementFor(button: HTMLElement) {
    return (
      button.querySelector<HTMLElement>("[data-copy-status]") ??
      button
        .closest("[data-copy-scope]")
        ?.querySelector<HTMLElement>("[data-copy-status]") ??
      null
    );
  }

  if (!document.documentElement.dataset.copyLinkBound) {
    document.documentElement.dataset.copyLinkBound = "true";

    document.addEventListener("click", async event => {
      const button = (event.target as Element).closest<HTMLElement>(
        "[data-copy-link]"
      );
      if (!button) return;
      event.preventDefault();

      let copied = true;
      try {
        await navigator.clipboard.writeText(button.dataset.copyLink ?? "");
      } catch {
        // Insecure context, or the user declined. Say so rather than staying
        // silent - with visible feedback, no change reads as "nothing happened"
        // and the reader cannot tell whether the link is on their clipboard.
        copied = false;
      }

      const status = statusElementFor(button);
      if (!status) return;

      // Text swap only, no transition: rule 10 requires a static resolution
      // under prefers-reduced-motion, and an instant swap satisfies it for
      // everyone without branching on the media query.
      const idle = status.dataset.idle ?? button.dataset.idle ?? "";
      status.textContent =
        (copied ? button.dataset.done : button.dataset.failed) ?? "";

      window.clearTimeout(Number(status.dataset.revertTimer));
      status.dataset.revertTimer = String(
        window.setTimeout(() => {
          status.textContent = idle;
        }, REVERT_AFTER_MS)
      );
    });
  }
</script>
