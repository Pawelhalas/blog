---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;
---

{/*
  Design rule 5: the date sits in a fixed-width left column, aligned across
  every row. The link wraps the title only - wrapping the whole row would
  make the description part of the link text for screen readers.

  Rows carry no separator: Pawel asked for the dividers to go, so rows are
  held apart by spacing and the date column's alignment alone.
*/}
<li
  class="grid grid-cols-[3.75rem_1fr] gap-x-4 py-4 sm:grid-cols-[4.5rem_1fr] sm:gap-x-8"
>
  <Datetime {...props} variant="column" class="pt-[0.4rem]" />
  <div>
    <a
      href={getPostUrl(id, filePath, Astro.currentLocale)}
      class="hover:text-accent focus-visible:text-accent inline-block"
    >
      <Heading
        transition:name={toTransitionName(id)}
        class="text-lg leading-snug font-medium"
      >
        {title}
      </Heading>
    </a>
    <p class="text-muted-foreground mt-1 text-base leading-relaxed">
      {description}
    </p>
  </div>
</li>
