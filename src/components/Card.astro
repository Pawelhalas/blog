---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { getHeroImage } from "@/utils/getHeroImage";
import Datetime from "./Datetime.astro";
import ShareMenu from "./ShareMenu.astro";

type Props = {
  variant?: "h2" | "h3";
  /**
   * "compact" is the original bare row: date column, title, description.
   * "rich" adds the hero thumbnail and the share menu, and makes the whole
   * row a click target. Scoped to /posts by decision on 2026-08-19 - the
   * homepage stays deliberately dense and thumbnail-free.
   * "featured" is the homepage's single highlighted post: a large hero image
   * beside a display-size title. It is one block, not a row in a list, which
   * is what earns it the extra weight without turning into a card.
   */
  layout?: "compact" | "rich" | "featured";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", layout = "compact", ...post } = Astro.props;

const { id, data, filePath } = post;
const { title, description, ...props } = data;

const href = getPostUrl(id, filePath, Astro.currentLocale);
const isRich = layout === "rich";
const isFeatured = layout === "featured";
const hero =
  isRich || isFeatured
    ? getHeroImage(post as CollectionEntry<"posts">)
    : undefined;
const shareUrl = new URL(href, Astro.site ?? Astro.url.origin).href;
---

{
  /*
  Design rule 5: the date sits in a fixed-width left column, aligned across
  every row. The link still wraps the title only - wrapping the whole row in an
  anchor would fold the description into the link's accessible name. The rich
  layout instead stretches an invisible ::after over the row, so the click
  target is the whole area while the announced name stays the title.

  Rows carry no separator: Pawel asked for the dividers to go, so rows are
  held apart by spacing and the date column's alignment alone.
*/
}
<li
  class:list={[
    "post-row",
    { "post-row--rich": isRich, "post-row--featured": isFeatured },
  ]}
>
  {
    /* Wrapped rather than styled directly: grid-area has to land on an element
      this component owns, not on one a child renders. */
  }
  <div class="post-row__date">
    <Datetime {...props} variant="column" />
  </div>

  <div class="post-row__body">
    <a
      href={href}
      class="post-row__link hover:text-accent focus-visible:text-accent inline-block"
    >
      <Heading
        transition:name={toTransitionName(id)}
        class:list={[
          "font-medium",
          isFeatured
            ? "text-2xl leading-tight sm:text-[1.75rem]"
            : "text-lg leading-snug",
        ]}
      >
        {title}
      </Heading>
    </a>
    <p
      class:list={[
        "text-muted-foreground leading-relaxed",
        isFeatured ? "mt-2 max-w-[60ch] text-base" : "mt-1 text-base",
      ]}
    >
      {description}
    </p>

    {
      isRich && (
        <div class="mt-2 flex">
          <ShareMenu url={shareUrl} {title} />
        </div>
      )
    }
  </div>

  {
    hero && (
      <div class="post-row__thumb">
        <Image
          src={hero.image}
          alt={hero.alt}
          widths={isFeatured ? [672, 1008, 1344] : [144, 288]}
          sizes={
            isFeatured
              ? "(min-width: 640px) 42rem, 100vw"
              : "(min-width: 640px) 9rem, 7rem"
          }
          loading={isFeatured ? "eager" : "lazy"}
          class="border-border w-full rounded-[2px] border object-cover"
        />
      </div>
    )
  }
</li>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 3.75rem 1fr;
    grid-template-areas: "date body";
    column-gap: 1rem;
    padding-block: 1rem;
  }

  .post-row--rich {
    position: relative;
    grid-template-columns: 3.75rem 1fr auto;
    grid-template-areas: "date body thumb";
  }

  /* Featured. The reference layout puts the image beside the headline, but the
     measure here is 768px: minus the date column that leaves ~280px of text,
     and a 28px Polish headline wraps to five lines in it. So the image sits
     above the text instead, both in the body column so the date column still
     aligns (rule 5). Emphasis comes from size and space only: no fill, no
     shadow, no frame beyond the 0.5px the image already carries. */
  .post-row--featured {
    position: relative;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "date"
      "thumb"
      "body";
    row-gap: 0.9rem;
    padding-block: 0.5rem 1.75rem;
  }

  .post-row__date {
    grid-area: date;
    padding-top: 0.4rem;
  }
  .post-row__body {
    grid-area: body;
  }
  .post-row__thumb {
    grid-area: thumb;
    width: 7rem;
    align-self: start;
  }

  .post-row__thumb :global(img) {
    aspect-ratio: 16 / 9;
  }

  .post-row--featured .post-row__date {
    padding-top: 0;
  }
  /* Capped rather than full-bleed: at the 768px measure an unconstrained 16:9
     image runs 355px tall and pushes the headline under the fold, which is the
     opposite of highlighting the post. */
  .post-row--featured .post-row__thumb {
    width: 100%;
    max-width: 32rem;
  }

  /* Whole-row click target. Sits under the share menu, which lifts itself
     with its own z-index. */
  .post-row--rich .post-row__link::after,
  .post-row--featured .post-row__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  @media (min-width: 640px) {
    .post-row {
      grid-template-columns: 4.5rem 1fr;
      column-gap: 2rem;
    }
    .post-row--rich {
      grid-template-columns: 4.5rem 1fr auto;
    }
    .post-row__thumb {
      width: 9rem;
    }

    .post-row--featured {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      grid-template-areas:
        "date thumb"
        ".    body";
      column-gap: 2rem;
      row-gap: 1.25rem;
    }
    .post-row--featured .post-row__date {
      padding-top: 0.4rem;
    }
    .post-row--featured .post-row__thumb {
      align-self: start;
    }
  }

  /* Step 8's date-column collapse, arriving early because the thumbnail
     needs the width. The date moves above the title; the thumbnail stays and
     spans both rows. */
  @media (max-width: 480px) {
    .post-row--rich {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "date thumb"
        "body thumb";
    }
    .post-row--rich .post-row__date {
      padding-top: 0;
      margin-bottom: 0.35rem;
    }
    .post-row--rich .post-row__thumb {
      width: 5.5rem;
    }
  }
</style>
