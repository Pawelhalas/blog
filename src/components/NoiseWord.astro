---
/**
 * Text rendered as eight clipped bands over an undistorted copy.
 *
 * Only the base copy carries the text for assistive tech and selection; the
 * eight overlays are aria-hidden, so a screen reader reads it once. Styling
 * lives in src/styles/distortion.css.
 *
 * Variants:
 *   hero - animates at full amplitude
 *   mark - permanently calm, 0.35 amplitude
 *   nav  - clean until hovered, focused, or current, then calm at 0.3
 */
import config from "@/config";

type Props = {
  variant?: "hero" | "mark" | "nav";
  /** Defaults to the site title. */
  text?: string;
  class?: string;
};

const {
  variant = "hero",
  text = config.site.title,
  class: className = "",
} = Astro.props;

const bands = [1, 2, 3, 4, 5, 6, 7, 8];

const amp = { hero: "1", mark: ".35", nav: ".3" }[variant];
const stateClass = { hero: "", mark: "is-calm", nav: "is-nav" }[variant];
---

<span
  class:list={["noise-word lowercase", stateClass, className]}
  style={`--amp:${amp}`}
>
  {
    bands.map(b => (
      <span class={`nb nb${b}`} aria-hidden="true">
        {text}
      </span>
    ))
  }
  <span class="nb-base">{text}</span>
</span>
