---
/**
 * Text rendered as eight clipped bands over an undistorted copy.
 *
 * Only the base copy carries the text for assistive tech and selection; the
 * eight overlays are aria-hidden, so a screen reader reads it once. Styling
 * lives in src/styles/distortion.css.
 *
 * Variants, with amplitude tuned to the type size each is used at:
 *   hero    - animates at full amplitude
 *   mark    - permanently calm, 0.35 (17px)
 *   heading - permanently calm, 0.5 (24-30px page headings)
 *   nav     - clean until hovered, focused or current, then calm at 0.3 (14px)
 */
import config from "@/config";

type Props = {
  variant?: "hero" | "mark" | "heading" | "nav";
  /**
   * Skip the lowercasing. Used for content the site does not own - a tag name
   * keeps the casing the tag vocabulary gives it (AI, Anthropic), even inside
   * an otherwise lowercased heading.
   */
  preserveCase?: boolean;
  /** Defaults to the site title. */
  text?: string;
  class?: string;
};

const {
  variant = "hero",
  text = config.site.title,
  preserveCase = false,
  class: className = "",
} = Astro.props;

const bands = [1, 2, 3, 4, 5, 6, 7, 8];

const amp = { hero: "1", mark: ".35", heading: ".5", nav: ".3" }[variant];
const stateClass = {
  hero: "",
  mark: "is-calm",
  heading: "is-calm",
  nav: "is-nav",
}[variant];
---

<span
  class:list={[
    "noise-word",
    preserveCase ? "normal-case" : "lowercase",
    stateClass,
    className,
  ]}
  style={`--amp:${amp}`}
>
  {
    bands.map(b => (
      <span class={`nb nb${b}`} aria-hidden="true">
        {text}
      </span>
    ))
  }
  <span class="nb-base">{text}</span>
</span>
