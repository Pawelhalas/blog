---
import LinkButton from "@/components/LinkButton.astro";
import CopyLinkButton from "@/components/CopyLinkButton.astro";
import { getShareTargets } from "@/utils/getShareTargets";
import { tplStr, useTranslations } from "@/i18n";

type Props = {
  /** Absolute URL of the post being shared. */
  url: string;
  title: string;
};

const { url, title } = Astro.props;
const t = useTranslations(Astro.currentLocale);

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

/*
  Platforms come from the shared helper, not from a list written here, so this
  row and the /posts dropdown always offer the same options. Copy-link is
  rendered first to match the dropdown's order.
*/
const items = await Promise.all(
  getShareTargets(url, title).map(async ({ name, platform, href, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    return {
      href,
      title: linkTitle ?? tplStr(t.post.sharePostOn, { platform }),
      Icon: mod?.default,
    };
  })
);
---

<div
  class="flex flex-none flex-col items-center justify-center gap-1 md:items-start"
>
  <span class="italic">{t.post.sharePostIntro}</span>
  <div class="flex items-center">
    <CopyLinkButton {url} variant="row" />
    {
      items.map(({ href, title: linkLabel, Icon }) =>
        Icon ? (
          <LinkButton
            href={href}
            class="scale-90 p-2 hover:rotate-6 sm:p-1"
            title={linkLabel}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
            <span class="sr-only">{linkLabel}</span>
          </LinkButton>
        ) : null
      )
    }
  </div>
</div>
