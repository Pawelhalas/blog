---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// Tag grid: getUniqueTags gives label + slug but no counts, so tally them here
// off the already-filtered post list.
const tags = getUniqueTags(posts);
const tagCounts = new Map<string, number>();
for (const post of sortedPosts) {
  for (const tag of post.data.tags) {
    const slug = slugifyStr(tag);
    tagCounts.set(slug, (tagCounts.get(slug) ?? 0) + 1);
  }
}

const rssHref = getRelativeLocaleUrl(locale, "rss.xml");
---

<Layout title="Więcej hałasu, mniej szumu">
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    {/*
      Hero. Rule 7 wants prose in the sans face; the blurb doubles as the page's
      h1, which the homepage would otherwise lack entirely. Capped at 46ch per
      the spec - site.description is 41, so it fits without truncation.

      The RSS link is one of rule 2's four sanctioned accent uses.
    */}
    <section id="hero" class="border-border border-b pt-10 pb-10">
      <h1 class="max-w-[46ch] text-3xl leading-tight font-medium text-balance">
        {site.description}
      </h1>
      <a
        href={rssHref}
        class="text-accent font-data mt-5 inline-flex items-center gap-2 text-[11px] tracking-[0.12em]"
        aria-label="RSS"
      >
        <IconRss width={14} height={14} class="rtl:-rotate-90" />
        RSS
      </a>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-10">
          <div class="border-border flex items-baseline justify-between border-b pb-2">
            <h2 class="font-data text-[11px] lowercase tracking-[0.12em]">
              {t.home.featured}
            </h2>
            <span class="font-data text-muted-foreground text-[11px] tabular-nums">
              {featuredPosts.length}
            </span>
          </div>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10">
          <div class="border-border flex items-baseline justify-between border-b pb-2">
            <h2 class="font-data text-[11px] lowercase tracking-[0.12em]">
              {t.home.recentPosts}
            </h2>
            <span class="font-data text-muted-foreground text-[11px] tabular-nums">
              {recentPosts.length}
            </span>
          </div>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          <div class="mt-6">
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="font-data hover:text-accent inline-flex items-center gap-2 text-[11px] tracking-[0.12em]"
            >
              {t.home.allPosts}
              <IconArrowRight width={14} height={14} class="rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {/*
      The tag grid is the one deliberately dense block on the page - a hairline
      lattice rather than chips, since rule 3 rules out fills and radii. It will
      read as sparse until the tag vocabulary grows; that is expected, not a
      layout bug.
    */}
    {
      tags.length > 0 && (
        <section id="tags" class="pt-10 pb-4">
          <div class="border-border flex items-baseline justify-between border-b pb-2">
            <h2 class="font-data text-[11px] lowercase tracking-[0.12em]">
              {t.nav.tags}
            </h2>
            <span class="font-data text-muted-foreground text-[11px] tabular-nums">
              {tags.length}
            </span>
          </div>
          {/*
            The frame is closed on all four sides so an incomplete final row
            (5 tags across 3 columns) does not leave a ragged bottom-right edge.
          */}
          <ul class="border-hairline-subtle mt-4 grid grid-cols-2 border-[0.5px] sm:grid-cols-3">
            {tags.map(({ tag, tagName }) => (
              <li class="border-hairline-subtle border-e-[0.5px] border-b-[0.5px]">
                <a
                  href={getRelativeLocaleUrl(locale, `tags/${tag}`)}
                  class="font-data hover:text-accent flex items-baseline justify-between gap-2 px-3 py-2.5 text-[11px] tracking-[0.08em]"
                >
                  <span class="truncate">{tagName}</span>
                  <span class="text-muted-foreground tabular-nums">
                    {tagCounts.get(tag) ?? 0}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
