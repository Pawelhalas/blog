---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
// Square crop of IMG_9875.jpg. The original is a wide 3:4 street shot, and
// object-fit can only take 25% off that - not enough to frame a portrait.
import portrait from "@/assets/images/pawel-portrait.jpg";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import NoiseWord from "@/components/NoiseWord.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// Tag grid: getUniqueTags gives label + slug but no counts, so tally them here
// off the already-filtered post list.
const tags = getUniqueTags(posts);
const tagCounts = new Map<string, number>();
for (const post of sortedPosts) {
  for (const tag of post.data.tags) {
    const slug = slugifyStr(tag);
    tagCounts.set(slug, (tagCounts.get(slug) ?? 0) + 1);
  }
}

const rssHref = getRelativeLocaleUrl(locale, "rss.xml");

const aboutSummary =
  "Cześć! Mam na imię Paweł i jestem product managerem z Wrocławia. Zapisuję tu swoje obserwacje i doświadczenia w ramach walki o jasność umysłu w świecie pełnym komunikacyjnego szumu i AI slopu.";
---

<Layout title="Więcej hałasu, mniej szumu">
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    {
      /*
      Hero. Rule 7 wants prose in the sans face; the blurb doubles as the page's
      h1, which the homepage would otherwise lack entirely. Capped at 46ch per
      the spec - site.description is 41, so it fits without truncation.

      The RSS link is one of rule 2's four sanctioned accent uses.
    */
    }
    {
      /*
      The hero is the site name as noise you can switch off. The button sits
      top-right of the section; its labels live in the markup so the wording
      stays here rather than in the script.
    */
    }
    <section id="hero" class="relative pt-12 pb-14">
      <div class="flex justify-end">
        <button
          type="button"
          data-noise-btn
          data-label-off="wyłącz szum"
          data-label-on="włącz szum"
          aria-pressed="false"
          class="font-data border-border hover:text-accent hover:border-accent rounded-[2px] border px-2.5 py-1.5 text-[11px] tracking-[0.08em]"
        >
          wyłącz szum
        </button>
      </div>
      <h1 class="mt-6 text-center text-[clamp(2.25rem,9vw,4.5rem)] sm:mt-4">
        <NoiseWord variant="hero" />
      </h1>
      <div class="mt-8 flex justify-center">
        <a
          href={rssHref}
          class="text-accent font-data inline-flex items-center gap-2 text-[11px] tracking-[0.12em]"
          aria-label="RSS"
        >
          <IconRss width={14} height={14} class="rtl:-rotate-90" />
          RSS
        </a>
      </div>
    </section>

    {
      /*
      About: a short standing summary, not a post. The photo sits in the same
      fixed-width left column the dates occupy in the post list below, so the
      section rhymes with the rest of the page instead of introducing a second
      layout. Square, hard-edged, no radius - rule 3 rules out rounded chips,
      which is what keeps this reading as an ID photo rather than an avatar.
    */
    }
    <section id="about" class="pb-12">
      <h2 class="font-data mb-3 text-[11px] tracking-[0.12em] lowercase">
        {t.nav.about}
      </h2>
      <div
        class="grid grid-cols-[3.75rem_1fr] gap-x-4 sm:grid-cols-[4.5rem_1fr] sm:gap-x-8"
      >
        <Image
          src={portrait}
          alt="Paweł"
          width={160}
          densities={[1, 2]}
          class="aspect-square w-full object-cover"
        />
        {
          /*
          Optical alignment: a paragraph's box top sits above its first cap by
          half the leading plus the ascender-to-cap gap - measured at 7.64px
          for IBM Plex Sans at 16px/26px, which is 0.478em. Expressed in em so
          it holds if the type scale changes. Without it the text reads as
          sitting low against the photo's hard top edge.
        */
        }
        <p
          class="text-muted-foreground mt-[-0.478em] max-w-[62ch] leading-relaxed"
        >
          {aboutSummary}
        </p>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pb-8">
          <h2 class="font-data mb-2 text-[11px] tracking-[0.12em] lowercase">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pb-8">
          <h2 class="font-data mb-2 text-[11px] tracking-[0.12em] lowercase">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          <div class="mt-6">
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="font-data hover:text-accent inline-flex items-center gap-2 text-[11px] tracking-[0.12em]"
            >
              {t.home.allPosts}
              <IconArrowRight width={14} height={14} class="rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      /*
      The tag grid is the one deliberately dense block on the page - a hairline
      lattice rather than chips, since rule 3 rules out fills and radii. It will
      read as sparse until the tag vocabulary grows; that is expected, not a
      layout bug.
    */
    }
    {
      tags.length > 0 && (
        <section id="tags" class="pb-10">
          <h2 class="font-data mb-2 text-[11px] tracking-[0.12em] lowercase">
            {t.nav.tags}
          </h2>
          {/*
            The frame is closed on all four sides so an incomplete final row
            (5 tags across 3 columns) does not leave a ragged bottom-right edge.
            The whole tag treatment is due to be reworked next.
          */}
          <ul class="border-hairline-subtle mt-3 grid grid-cols-2 border-[0.5px] sm:grid-cols-3">
            {tags.map(({ tag, tagName }) => (
              <li class="border-hairline-subtle border-e-[0.5px] border-b-[0.5px]">
                <a
                  href={getRelativeLocaleUrl(locale, `tags/${tag}`)}
                  class="font-data hover:text-accent flex items-baseline justify-between gap-2 px-3 py-2.5 text-[11px] tracking-[0.08em]"
                >
                  <span class="truncate">{tagName}</span>
                  <span class="text-muted-foreground tabular-nums">
                    {tagCounts.get(tag) ?? 0}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
